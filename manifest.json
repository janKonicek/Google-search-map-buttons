{
   "manifest_version": 3,
   "name": "Map buttons",
   "version": "2.2.0",
   "description": "Restores the Maps button in Google Search and adds Mapy.com, OSM, and Apple Maps integration.",
   "permissions": [ "activeTab", "storage" ],
   "action": {
      "default_popup": "popup.html",
      "default_title": "Map Settings"
   },
   "icons": {
      "48": "images/icon48.png", 
      "128": "images/icon128.png"
   },
   "content_scripts": [ {
      "js": [ "src/addMapsBtn.js" ],
      "matches": [ "https://www.google.com/search*", "https://www.google.cz/search*" ]
   } ],
   "web_accessible_resources": [
      {
         "resources": [ "images/*.svg", "images/*.png" ],
         "matches": [ "https://www.google.com/*", "https://www.google.cz/*" ]
      }
   ]
}